# Copy this file to .env and fill in the real values locally.
# Never expose these keys through VITE_* variables or frontend code.
SONIOX_API_KEY=your_soniox_api_key
OPENAI_API_KEY=your_openai_api_key

# Optional defaults
OPENAI_MODEL=gpt-5-nano
# Transcript characters sent to the model per analysis call (long transcripts are
# split into chunks of this size and analysed one after another).
ANALYZE_CHUNK_CHARS=12000
PORT=3001
