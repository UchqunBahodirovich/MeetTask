# Copy this file to .env and fill in the real values locally.
# Never expose these keys through VITE_* variables or frontend code.
SONIOX_API_KEY=your_soniox_api_key
OPENAI_API_KEY=your_openai_api_key

# Firestore (productionda Application Default Credentials ishlatiladi)
GOOGLE_CLOUD_PROJECT=your_firebase_project_id
# Lokal Firebase emulator uchun, productionda olib tashlang:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Kamida 32 belgilik alohida sirlar
JWT_SECRET=replace_with_a_long_random_access_secret
REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
CORS_ORIGINS=http://localhost:3000,https://meettaskai.web.app
# Lokal HTTP uchun false, production HTTPS uchun true
COOKIE_SECURE=false
# Faqat frontend API auth'ga ko‘chirilayotgan lokal davrda true qiling.
# Productionda doim false bo‘lishi kerak.
ALLOW_LEGACY_API=false

# Optional defaults
OPENAI_MODEL=gpt-5-nano
# Transcript characters sent to the model per analysis call (long transcripts are
# split into chunks of this size and analysed one after another).
ANALYZE_CHUNK_CHARS=12000
PORT=3001

# Only needed when the static site and the API run on different origins
# (e.g. Firebase Hosting). Leave empty when serving both from one server.
VITE_API_BASE_URL=
