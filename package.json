{
  "name": "meettask",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n firestore,web,api -c yellow,blue,green \"firebase emulators:start --only firestore --import=./.emulator-data --export-on-exit=./.emulator-data\" \"vite\" \"go run ./backend/cmd/api\"",
    "build": "vite build",
    "start": "go run ./backend/cmd/api",
    "preview": "npm run build && npm run start",
    "check:integrations": "node scripts/check-integrations.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@google/genai": "^0.7.0",
    "@soniox/client": "^2.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "autoprefixer": "^10.4.27",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "date-fns": "^4.1.0",
    "firebase": "^12.18.0",
    "framer-motion": "^12.35.2",
    "lucide-react": "^0.577.0",
    "postcss": "^8.5.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "simple-icons": "^16.32.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
